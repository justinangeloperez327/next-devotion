# PostgreSQL connection string used by Prisma.
# Replace these development values with your actual database credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_devotion?schema=public"


# Optional authenticated Playwright test account.
# Use a dedicated non-production account/database for E2E tests.
E2E_EMAIL=""
E2E_PASSWORD=""

# Optional: point Playwright at an already-running deployment instead of starting npm run dev.
PLAYWRIGHT_BASE_URL=""

{
  "name": "next-devotion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --config ./prisma7.config.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate --config ./prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config ./prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config ./prisma7.config.ts",
    "db:studio": "prisma studio --config ./prisma7.config.ts",
    "db:validate": "prisma validate --config ./prisma7.config.ts",
    "db:format": "prisma format --schema ./prisma/schema.prisma",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:all": "npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "deployment:check": "node scripts/deployment-preflight.mjs",
    "db:status": "prisma migrate status --config ./prisma7.config.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.1",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.5",
    "eslint": "10.0.1",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "@playwright/test": "1.63.0",
    "vitest": "5.0.3"
  }
}

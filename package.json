    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.5",
    "eslint": "10.0.1",

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DevotionVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id                        String             @id @default(uuid()) @db.Uuid
  name                      String             @db.VarChar(80)
  username                  String             @unique @db.VarChar(30)
  email                     String             @unique @db.VarChar(254)
  passwordHash              String
  avatarUrl                 String?            @db.VarChar(2048)
  bio                       String?            @db.VarChar(280)
  defaultDevotionVisibility DevotionVisibility @default(PUBLIC)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  sessions       Session[]
  devotions      Devotion[]
  amens          Amen[]
  comments       Comment[]
  savedDevotions SavedDevotion[]

  @@index([createdAt])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Devotion {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @db.Uuid
  scriptureReference String             @db.VarChar(120)
  scriptureText      String?            @db.VarChar(1200)
  observation        String             @db.VarChar(4000)
  application        String             @db.VarChar(4000)
  prayer             String             @db.VarChar(4000)
  visibility         DevotionVisibility @default(PUBLIC)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  amens    Amen[]
  comments Comment[]
  savedBy  SavedDevotion[]

  @@index([userId, createdAt, id])
  @@index([userId, visibility, createdAt, id])
  @@index([visibility, createdAt, id])
  @@map("devotions")
}

model Amen {
  userId     String   @db.Uuid
  devotionId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devotion Devotion @relation(fields: [devotionId], references: [id], onDelete: Cascade)

  @@id([userId, devotionId])
  @@index([devotionId, createdAt])
  @@map("amens")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  devotionId String   @db.Uuid
  body       String   @db.VarChar(2000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devotion Devotion @relation(fields: [devotionId], references: [id], onDelete: Cascade)

  @@index([devotionId, createdAt, id])
  @@index([userId, createdAt])
  @@map("comments")
}

model SavedDevotion {
  userId     String   @db.Uuid
  devotionId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devotion Devotion @relation(fields: [devotionId], references: [id], onDelete: Cascade)

  @@id([userId, devotionId])
  @@index([userId, createdAt, devotionId])
  @@index([devotionId])
  @@map("saved_devotions")
}

model RateLimitBucket {
  key       String   @id @db.Char(64)
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
